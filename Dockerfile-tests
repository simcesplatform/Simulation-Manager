FROM python:3.12.11-slim

# Ensure that the used folders exist
RUN mkdir -p /dummy && \
    mkdir -p /init && \
    mkdir -p /listener && \
    mkdir -p /manager && \
    mkdir -p /simulation-tools

# Install the required packages
COPY requirements.txt /requirements.txt
RUN pip install --upgrade pip && \
    pip install -r /requirements.txt

# Copy the application files
COPY dummy/ /tests/dummy/
COPY init/ /tests/init/
COPY listener/ tests/listener/
COPY manager/ /tests/manager/
COPY simulation-tools/ /tests/simulation-tools/
COPY run_tests.py /tests/run_tests.py

# Set the working directory in the container
WORKDIR /tests

# Set the command to run the application
CMD [ "python3", "-u", "run_tests.py" ]
